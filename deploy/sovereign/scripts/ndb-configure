#!/usr/bin/env bash
# ndb-configure — render /etc/ndb/ndb.conf into the runtime env file and the
# systemd cgroup drop-ins, then restart + verify the nDB services.
#
# Why a renderer: systemd does NOT expand ${VAR} in resource directives
# (MemoryMax=, CPUQuota=…), so a single env file can't carry the caps. This
# reads ONE text file (ndb.conf) and writes both the env vars AND literal-valued
# drop-ins, so the operator edits one place.
#
#   sudo ndb-configure                 # render, restart, verify (auto-rollback on failure)
#   sudo ndb-configure --dry-run       # print what would be written; change nothing
#   sudo ndb-configure --no-restart    # render only; you restart when ready
#   sudo ndb-configure --conf /path/to/ndb.conf
set -euo pipefail

CONF=/etc/ndb/ndb.conf
ENV=/etc/ndb/ndb.env
DRYRUN=0; RESTART=1
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)    DRYRUN=1 ;;
    --no-restart) RESTART=0 ;;
    --conf)       CONF="$2"; shift ;;
    *) echo "unknown arg: $1"; exit 2 ;;
  esac; shift
done

# dry-run writes nothing, so it doesn't need root.
[ "$DRYRUN" -eq 1 ] || [ "$(id -u)" -eq 0 ] || { echo "run as root (writes /etc/ndb + /etc/systemd)"; exit 1; }
[ -f "$CONF" ] || { echo "config not found: $CONF (copy ndb.conf.example there)"; exit 1; }

# read a KEY=value from the conf (last wins, value may contain '='). Strips a
# trailing " # inline comment" and surrounding whitespace. blank if absent.
cfg(){ grep -E "^[[:space:]]*$1=" "$CONF" 2>/dev/null | tail -1 \
  | sed -E "s/^[[:space:]]*$1=[[:space:]]*//; s/[[:space:]]+#.*$//; s/[[:space:]]+$//" || true; }

TS=$(date +%s)
TMPENV=$(mktemp)
trap 'rm -f "$TMPENV"' EXIT

# ---- 1) render the runtime env file -------------------------------------
emit(){ local k="$1" v="$2"; [ -n "$v" ] && printf '%s=%s\n' "$k" "$v" >> "$TMPENV"; return 0; }
{
  echo "# generated by ndb-configure from ${CONF} — DO NOT EDIT (edit ndb.conf)"
} > "$TMPENV"
emit NDB_TOKEN                "$(cfg NDB_TOKEN)"
emit NDB_WRITE_TOKEN          "$(cfg NDB_WRITE_TOKEN)"
emit NDB_MCP_MAX_CONN         "$(cfg MCP_MAX_CONN)"
emit NDB_MAX_CONNECTIONS      "$(cfg SERVER_MAX_CONN)"
emit MALLOC_ARENA_MAX         "$(cfg MALLOC_ARENA_MAX)"
emit NDB_MEMTABLE_FLUSH_BYTES "$(cfg NDB_MEMTABLE_FLUSH_BYTES)"
emit NDB_EMBED_URL            "$(cfg NDB_EMBED_URL)"
emit NDB_EDGE_BIND            "$(cfg NDB_EDGE_BIND)"
emit NDB_TLS_CERT             "$(cfg NDB_TLS_CERT)"
emit NDB_TLS_KEY              "$(cfg NDB_TLS_KEY)"
emit NDB_DATA_UPSTREAM        "$(cfg NDB_DATA_UPSTREAM)"
emit NDB_MCP_UPSTREAM         "$(cfg NDB_MCP_UPSTREAM)"
emit RUST_LOG                 "$(cfg RUST_LOG)"
emit NDB_MCP_PRINCIPAL        "$(cfg NDB_MCP_PRINCIPAL)"

# ---- 2) per-service cgroup drop-ins -------------------------------------
# unit -> "MEM_HIGH MEM_MAX CPU_QUOTA" cfg-key triplet (EMBED has no HIGH/CPU here)
dropin_for(){
  local unit="$1" high="$2" max="$3" cpu="$4"
  systemctl cat "$unit" >/dev/null 2>&1 || { echo "  (skip $unit — not installed)"; return; }
  local dir="/etc/systemd/system/${unit}.service.d"
  local f="${dir}/zz-ndb-conf.conf"
  local body="[Service]"$'\n'"# generated by ndb-configure from ${CONF}"
  [ -n "$high" ] && body+=$'\n'"MemoryHigh=${high}"
  [ -n "$max" ]  && body+=$'\n'"MemoryMax=${max}"
  [ -n "$cpu" ]  && body+=$'\n'"CPUQuota=${cpu}"
  if [ "$DRYRUN" -eq 1 ]; then
    echo "--- would write ${f}:"; printf '%s\n' "$body" | sed 's/^/    /'
  else
    mkdir -p "$dir"; printf '%s\n' "$body" > "$f"
    echo "  wrote ${f}"
  fi
}

echo "rendering from ${CONF}:"
if [ "$DRYRUN" -eq 1 ]; then
  echo "--- would write ${ENV}:"; sed 's/^/    /' "$TMPENV"
else
  [ -f "$ENV" ] && cp -a "$ENV" "${ENV}.bak-${TS}"
  install -m 0600 "$TMPENV" "$ENV"
  echo "  wrote ${ENV} (backup: ${ENV}.bak-${TS})"
fi
dropin_for ndb-mcp    "$(cfg MCP_MEM_HIGH)"    "$(cfg MCP_MEM_MAX)"    "$(cfg CPU_QUOTA_MCP)"
dropin_for ndb-server "$(cfg SERVER_MEM_HIGH)" "$(cfg SERVER_MEM_MAX)" "$(cfg CPU_QUOTA_SERVER)"
dropin_for ndb-edge   "$(cfg EDGE_MEM_HIGH)"   "$(cfg EDGE_MEM_MAX)"   "$(cfg CPU_QUOTA_EDGE)"
dropin_for ndb-embed  ""                       "$(cfg EMBED_MEM_MAX)"  ""

[ "$DRYRUN" -eq 1 ] && { echo "dry-run: nothing changed."; exit 0; }

systemctl daemon-reload
[ "$RESTART" -eq 0 ] && { echo "rendered. --no-restart set; apply with: systemctl restart ndb-server ndb-mcp ndb-edge"; exit 0; }

# ---- 3) restart present services + verify, rollback on failure ----------
UNITS=(); for u in ndb-server ndb-mcp ndb-edge ndb-embed; do
  systemctl cat "$u" >/dev/null 2>&1 && UNITS+=("$u"); done
echo "restarting: ${UNITS[*]}"
ok=1
for u in "${UNITS[@]}"; do systemctl restart "$u" || ok=0; done
sleep 2
for u in "${UNITS[@]}"; do
  if ! systemctl is-active --quiet "$u"; then echo "  ✗ $u failed to start"; ok=0; else echo "  ✓ $u active"; fi
done

if [ "$ok" -ne 1 ]; then
  echo "ROLLING BACK (a service did not come up)…"
  [ -f "${ENV}.bak-${TS}" ] && cp -a "${ENV}.bak-${TS}" "$ENV"
  for u in ndb-mcp ndb-server ndb-edge ndb-embed; do
    rm -f "/etc/systemd/system/${u}.service.d/zz-ndb-conf.conf" 2>/dev/null || true
  done
  systemctl daemon-reload
  for u in "${UNITS[@]}"; do systemctl restart "$u" 2>/dev/null || true; done
  echo "rolled back to pre-render state. check: journalctl -u <unit> -n 50"
  exit 1
fi

echo "✅ applied. effective caps:"
for u in "${UNITS[@]}"; do
  printf "  %-12s " "$u"; systemctl show "$u" -p MemoryHigh,MemoryMax,CPUQuotaPerSecUSec 2>/dev/null | tr '\n' ' '; echo
done
