# nDB MCP server, Streamable HTTP transport (AI agents). Plain HTTP on
# localhost; the edge terminates TLS. When NDB_TOKEN is set in the env file,
# POST /mcp requires Authorization: Bearer <token> (GET /health stays open).
#
# Opens its OWN copy of the DB directory (the engine is single-writer). For a
# read-only agent surface, point --path at a read replica / snapshot copy.
[Unit]
Description=nDB MCP server (Streamable HTTP, /mcp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ndb
Group=ndb
# '-' => tolerate a missing env file (it's generated by `ndb-configure`).
EnvironmentFile=-/etc/ndb/ndb.env
# Baseline allocator cap so RSS stays bounded even before ndb-configure runs
# (ndb.conf/ndb.env can override). A thread-per-connection server otherwise
# spreads allocations across 8*nCPU glibc arenas that retain freed memory.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/local/bin/ndb-mcp-server --http 127.0.0.1:9000 --path /var/lib/ndb/mcp-data
Restart=on-failure
RestartSec=2
# baseline caps (ndb-configure drop-ins override these from /etc/ndb/ndb.conf)
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=0
CPUQuota=50%
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ndb
PrivateTmp=true

[Install]
WantedBy=multi-user.target
